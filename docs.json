{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RollingGo Docs",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/logo/logo.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:partner@rollinggo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "href": "https://partner.rollinggo.ai",
      "label": "Get Started"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "MCP Integration Guide",
                "pages": [
                  "mcp-docs/quick-start",
                  "mcp-docs/mcp-tool-reference",
                  "mcp-docs/oauthdoc",
                  "update/update2"
                ]
              },
              {
                "group": "Monetization & Partners",
                "pages": [
                  "partnerdoc/kol",
                  "partnerdoc/partner1"
                ]
              },
              {
                "group": "Client Config & Auth",
                "pages": [
                  "developer-insights/mcp-client-config",
                  "developer-insights/developer-insights-mcp-auth-comparison"
                ]
              },
              {
                "group": "FAQ",
                "pages": [
                  "faq/faq"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "groups": [
              {
                "group": "Changelog & Updates",
                "pages": []
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "Support",
              "href": "mailto:partner@rollinggo.ai"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.ai",
            "label": "Get Started"
          }
        }
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "使用文档",
            "groups": [
              {
                "group": "MCP 接入指南",
                "pages": [
                  "zh/mcp-docs/quick-start",
                  "zh/mcp-docs/mcp-tool-reference",
                  "zh/mcp-docs/oauthdoc",
                  "zh/update/update2"
                ]
              },
              {
                "group": "变现与合作指南",
                "pages": [
                  "zh/partnerdoc/kol",
                  "zh/partnerdoc/partner1"
                ]
              },
              {
                "group": "客户端接入与比较",
                "pages": [
                  "zh/developer-insights/mcp-client-config",
                  "zh/developer-insights/developer-insights-mcp-auth-comparison"
                ]
              },
              {
                "group": "常见问题解答 (FAQ)",
                "pages": [
                  "zh/faq/faq"
                ]
              }
            ]
          },
          {
            "tab": "更新日志",
            "groups": [
              {
                "group": "版本更新日志",
                "pages": []
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "联系我们",
              "href": "mailto:partner@rollinggo.cn"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.cn",
            "label": "申请入驻"
          }
        }
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RollingGoTravel"
    }
  },
  "redirects": [
    {
      "source": "/en",
      "destination": "/mcp-docs/quick-start",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/mcp-docs/quick-start",
      "permanent": true
    },
    {
      "source": "/en/:path+",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "strict": true
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "download-pdf"
    ],
    "display": "header"
  }
}

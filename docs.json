{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RollingGo Docs",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/logo/logo.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "icon": "house",
        "href": "https://global.rollinggo.store",
        "label": "Home"
      },
      {
        "label": "Support",
        "href": "mailto:partner@rollinggo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "href": "https://partner.rollinggo.ai/register",
      "label": "Get Started"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "MCP Integration Guide",
                "pages": [
                  "guides/quick-start",
                  "guides/tools",
                  "guides/oauth",
                  "guides/mini-program"
                ]
              },
              {
                "group": "Monetization & Partners",
                "pages": [
                  "partners/kol",
                  "partners/developers"
                ]
              },
              {
                "group": "Client Config & Auth",
                "pages": [
                  "clients/config",
                  "clients/auth-comparison"
                ]
              },
              {
                "group": "FAQ",
                "pages": [
                  "faq"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "groups": [
              {
                "group": "Changelog & Updates",
                "pages": []
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "icon": "house",
              "href": "https://global.rollinggo.store",
              "label": "Home"
            },
            {
              "label": "Support",
              "href": "mailto:partner@rollinggo.ai"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.ai/register",
            "label": "Get Started"
          }
        }
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "使用文档",
            "groups": [
              {
                "group": "MCP 接入指南",
                "pages": [
                  "zh/guides/quick-start",
                  "zh/guides/tools",
                  "zh/guides/oauth",
                  "zh/guides/mini-program"
                ]
              },
              {
                "group": "变现与合作指南",
                "pages": [
                  "zh/partners/kol",
                  "zh/partners/developers"
                ]
              },
              {
                "group": "客户端接入与比较",
                "pages": [
                  "zh/clients/config",
                  "zh/clients/auth-comparison"
                ]
              },
              {
                "group": "常见问题解答 (FAQ)",
                "pages": [
                  "zh/faq"
                ]
              }
            ]
          },
          {
            "tab": "更新日志",
            "groups": [
              {
                "group": "版本更新日志",
                "pages": []
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "icon": "house",
              "href": "https://rollinggo.store",
              "label": "官网"
            },
            {
              "label": "联系我们",
              "href": "mailto:partner@rollinggo.cn"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.cn/register",
            "label": "申请入驻"
          }
        }
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RollingGoTravel"
    }
  },
  "redirects": [
    {
      "source": "/en",
      "destination": "/guides/quick-start",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/guides/quick-start",
      "permanent": true
    },
    {
      "source": "/en/:path+",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/mcp-docs/quick-start",
      "destination": "/guides/quick-start",
      "permanent": true
    },
    {
      "source": "/mcp-docs/mcp-tool-reference",
      "destination": "/guides/tools",
      "permanent": true
    },
    {
      "source": "/mcp-docs/oauthdoc",
      "destination": "/guides/oauth",
      "permanent": true
    },
    {
      "source": "/update/update2",
      "destination": "/guides/mini-program",
      "permanent": true
    },
    {
      "source": "/developer-insights/mcp-client-config",
      "destination": "/clients/config",
      "permanent": true
    },
    {
      "source": "/developer-insights/developer-insights-mcp-auth-comparison",
      "destination": "/clients/auth-comparison",
      "permanent": true
    },
    {
      "source": "/partnerdoc/partner1",
      "destination": "/partners/developers",
      "permanent": true
    },
    {
      "source": "/partnerdoc/kol",
      "destination": "/partners/kol",
      "permanent": true
    },
    {
      "source": "/faq/faq",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/zh/mcp-docs/quick-start",
      "destination": "/zh/guides/quick-start",
      "permanent": true
    },
    {
      "source": "/zh/mcp-docs/mcp-tool-reference",
      "destination": "/zh/guides/tools",
      "permanent": true
    },
    {
      "source": "/zh/mcp-docs/oauthdoc",
      "destination": "/zh/guides/oauth",
      "permanent": true
    },
    {
      "source": "/zh/update/update2",
      "destination": "/zh/guides/mini-program",
      "permanent": true
    },
    {
      "source": "/zh/developer-insights/mcp-client-config",
      "destination": "/zh/clients/config",
      "permanent": true
    },
    {
      "source": "/zh/developer-insights/developer-insights-mcp-auth-comparison",
      "destination": "/zh/clients/auth-comparison",
      "permanent": true
    },
    {
      "source": "/zh/partnerdoc/partner1",
      "destination": "/zh/partners/developers",
      "permanent": true
    },
    {
      "source": "/zh/partnerdoc/kol",
      "destination": "/zh/partners/kol",
      "permanent": true
    },
    {
      "source": "/zh/faq/faq",
      "destination": "/zh/faq",
      "permanent": true
    }
  ],
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "strict": true
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "download-pdf"
    ],
    "display": "header"
  }
}

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RollingGo Docs",
  "colors": {
    "primary": "#ef7025",
    "light": "#eec9bc",
    "dark": "#4fa1ab"
  },
  "favicon": "/logo/logo.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Home",
        "href": "https://global.rollinggo.store"
      },
      {
        "label": "Support",
        "href": "mailto:partner@rollinggo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "href": "https://partner.rollinggo.ai/register",
      "label": "Get Started"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "guides/overview",
                  "guides/redirect-mode",
                  "guides/closed-loop-mode"
                ]
              },
              {
                "group": "API & Capabilities",
                "pages": [
                  "guides/tools",
                  "guides/oauth",
                  "guides/payment"
                ]
              },
              {
                "group": "Client Configuration",
                "pages": [
                  "clients/config"
                ]
              },
              {
                "group": "Partnership & Monetization",
                "pages": [
                  "partners/kol",
                  "partners/developers"
                ]
              },
              {
                "group": "Support",
                "pages": [
                  "faq"
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "groups": [
              {
                "group": "Release Notes",
                "pages": [
                  "changelog/mcp",
                  "changelog/website"
                ]
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "Home",
              "href": "https://global.rollinggo.store"
            },
            {
              "label": "Support",
              "href": "mailto:partner@rollinggo.ai"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.ai/register",
            "label": "Get Started"
          }
        }
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "使用文档",
            "groups": [
              {
                "group": "接入指南",
                "pages": [
                  "zh/guides/overview",
                  "zh/guides/redirect-mode",
                  "zh/guides/closed-loop-mode"
                ]
              },
              {
                "group": "接口与能力",
                "pages": [
                  "zh/guides/tools",
                  "zh/guides/oauth",
                  "zh/guides/payment"
                ]
              },
              {
                "group": "客户端配置",
                "pages": [
                  "zh/clients/config"
                ]
              },
              {
                "group": "商业合作",
                "pages": [
                  "zh/partners/kol",
                  "zh/partners/developers"
                ]
              },
              {
                "group": "常见问题",
                "pages": [
                  "zh/faq"
                ]
              }
            ]
          },
          {
            "tab": "更新日志",
            "groups": [
              {
                "group": "版本发布记录",
                "pages": [
                  "zh/changelog/mcp",
                  "zh/changelog/website"
                ]
              }
            ]
          }
        ],
        "navbar": {
          "links": [
            {
              "label": "官网",
              "href": "https://rollinggo.store"
            },
            {
              "label": "联系我们",
              "href": "mailto:partner@rollinggo.cn"
            }
          ],
          "primary": {
            "type": "button",
            "href": "https://partner.rollinggo.cn/register",
            "label": "申请入驻"
          }
        }
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/RollingGoTravel"
    }
  },
  "redirects": [
    {
      "source": "/en",
      "destination": "/guides/overview",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/guides/overview",
      "permanent": true
    },
    {
      "source": "/en/:path+",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/guides/quick-start",
      "destination": "/guides/redirect-mode",
      "permanent": true
